{
  "name": "slides",
  "version": "1.0.0",
  "description": "Slides — web-based fullscreen presentation theme with channels and HTML slides",
  "scripts": {
    "build": "npm-run-all build:fonts build:daisyui build:css build:js",
    "build:fonts": "mkdir -p assets/webfonts && cp -r node_modules/@fortawesome/fontawesome-free/webfonts/* assets/webfonts/",
    "build:daisyui": "mkdir -p assets/css && cp node_modules/daisyui/daisyui.css assets/css/daisyui.css",
    "build:css": "npx tailwindcss -i ./src/stylesheets/application.css -o ./assets/css/main.css",
    "build:js": "esbuild ./src/javascripts/application.js --bundle --minify --outfile=./assets/javascripts/main.js",
    "dev": "npm-run-all build:fonts build:daisyui --parallel 'build:css -- --watch' 'build:js -- --watch'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@ryangjchandler/alpine-clipboard": "^2.3.0",
    "alpinejs": "3.13.3",
    "chart.js": "^4.4.6",
    "daisyui": "^5.0.35",
    "gsap": "^3.12.7",
    "highlight.js": "^11.11.1",
    "lucide": "^1.31.0",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.4.1",
    "qrcode": "^1.5.4",
    "swiper": "11.0.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "esbuild": "^0.19.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.0"
  }
}
