<main class="min-h-screen bg-gray-50">
  <section class="bg-gradient-to-r from-primary to-purple-600 py-10 text-white">
    <div class="container mx-auto px-4 xl:max-w-6xl">
      <h1 class="text-3xl font-bold md:text-4xl">{{ 'search.title' | t }}</h1>
      <p class="mt-2 text-gray-100">{{ 'search.hint' | t }}</p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-10 xl:max-w-4xl">
    <div class="rounded-lg bg-white p-4 shadow-md">
      {% form_tag 'search' %}
        <label class="flex items-center gap-3">
          <input type="search" name="{{ form.keywords_field_name }}" value="{{ search.keywords | escape_once }}" class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:ring-2 focus:ring-primary" placeholder="{{ 'search.placeholder' | t }}" x-init="$nextTick(() => { $el.focus(); $el.setSelectionRange($el.value.length, $el.value.length); })" />
          <button type="submit" class="rounded-lg bg-primary px-5 py-3 font-medium text-white">{{ 'search.submit' | t }}</button>
        </label>
      {% endform_tag %}
    </div>

    <div class="mt-6 space-y-3">
      {% if search.keywords or search.tag %}
        {% if search.page_number == 1 %}
          {% for link in search.extends %}
            <article class="rounded-lg bg-white p-4 shadow-md">
              <a href="{{ link.url }}" class="block text-base font-semibold text-gray-800 hover:text-primary search-highlight-block">{{ link.link_text }}</a>
              <p class="mt-1 line-clamp-2 text-xs text-gray-500 search-highlight-block">{{ link.url }}</p>
            </article>
          {% endfor %}
        {% endif %}
        {% paginate_tag search.pages, as: 'items' %}
          {% for page in items %}
            <article class="rounded-lg bg-white p-4 shadow-md transition hover:shadow-lg">
              <h2 class="text-base font-semibold text-gray-800">
                <a href="{{ page.path }}" class="hover:text-primary search-highlight-block">{{ page.highlighted_search_title }}</a>
              </h2>
              <p class="mt-1 line-clamp-3 text-sm text-gray-600 search-highlight-block">{{ page.highlighted_search_content }}</p>
            </article>
          {% else %}
            <p class="rounded-lg bg-white px-4 py-16 text-center text-sm text-gray-500 shadow-md">{{ 'search.empty' | t }}</p>
          {% endfor %}
          <div class="mt-6">{% render '@shared/paginate' %}</div>
        {% endpaginate_tag %}
      {% else %}
        <p class="rounded-lg bg-white px-4 py-16 text-center text-sm text-gray-500 shadow-md">{{ 'search.prompt' | t }}</p>
      {% endif %}
    </div>
  </section>
</main>
