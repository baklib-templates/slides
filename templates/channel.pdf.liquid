{% comment %} PDF 版本栏目页：全宽幻灯片预览，Ctrl+P 逐页打印给客户 {% endcomment %}
{% assign slides = page.children_in_list %}
{% assign slides_count = slides | size %}

<style>
  /* —— 打印：一页一张幻灯片，零边距铺满 —— */
  @media print {
    @page {
      size: landscape;
      margin: 0;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0 !important;
      padding: 0 !important;
      background: #fff !important;
      overflow: hidden;
    }

    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
      box-shadow: none !important;
      text-shadow: none !important;
    }

    .pdf-deck {
      display: block;
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    .slide-page {
      position: relative;
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100vh;
      min-height: 100vh;
      max-height: 100vh;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
      background: #fff;
      overflow: hidden;
      page-break-after: always;
      break-after: page;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .slide-page:last-child {
      page-break-after: auto;
      break-after: auto;
    }

    .slide-content,
    .content-wrapper,
    .slide-closing {
      width: 100%;
      height: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
      overflow: hidden;
    }

    .no-print {
      display: none !important;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img,
    svg,
    canvas,
    video {
      max-width: 100%;
      page-break-inside: avoid;
      break-inside: avoid;
    }
  }

  /* —— 屏幕：全宽适配，16:9 预览打印效果 —— */
  @media screen {
    html,
    body {
      margin: 0;
      padding: 0;
      background: #e8eef5;
    }

    .pdf-deck {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      gap: 0.75rem;
    }

    .slide-page {
      width: 100%;
      max-width: 100%;
      aspect-ratio: 16 / 9;
      height: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
      background: #fff;
      overflow: hidden;
    }

    .slide-content,
    .content-wrapper,
    .slide-closing {
      width: 100%;
      height: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
    }
  }

  /* —— 通用 —— */
  body {
    font-family: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #1e293b;
    line-height: 1.6;
  }

  .slide-page {
    display: flex;
    flex-direction: column;
    justify-content: stretch;
    align-items: stretch;
    text-align: left;
  }

  .slide-content {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
  }

  /* 结语页：去掉内边距与圆角，与内容页一致铺满 */
  .slide-closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: hsl(var(--theme-color-primary) / 0.12);
    color: inherit;
    overflow: hidden;
  }
</style>

<main class="pdf-deck">
  {% for slide in slides %}
    <section class="slide-page">
      <div class="slide-content">
        <div class="content-wrapper slide-html-host">
          {{ slide.settings.html_content }}
        </div>
      </div>
    </section>
  {% endfor %}

  {% comment %} 结语页：与 channel.liquid「结语幻灯片」信息一致，版式改为打印友好 {% endcomment %}
  <section class="slide-page">
    <div class="slide-closing">
      <div class="flex flex-col items-center justify-center gap-2">
        {% assign default_logo = 'images/theme/logo-white.svg' | asset_url %}
        <img
          src="{{ site.settings.logo_url | default: default_logo }}"
          alt="{{ site.name | escape }}"
          class="h-32 object-contain"
        >
      </div>

      <h2 class="text-3xl lg:text-4xl text-base-content mb-6">
        {{ site.settings.company_name }}
      </h2>
      <div class="flex max-w-6xl mx-auto text-base lg:text-xl text-base-content/70 leading-5 md:leading-8">
        {{ site.settings.company_descriptionn }}
      </div>

      <div class="mt-16 text-primary">
        <a href="{{ site.settings.company_website_url }}" target="_blank" rel="noopener noreferrer">{{ site.settings.company_website_url }}</a>
      </div>
    </div>
  </section>
</main>

{% schema %}
  {
    "name": "栏目页 - PDF 版本",
    "description": "PDF 版本栏目页，全宽幻灯片预览，适合 Ctrl+P 打印输出给客户",
    "thumb_url": "images/theme/thumb.png",
    "preview_image_urls": [
      "images/theme/${lang}/channel.png"
    ],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "title",
        "type": "text",
         "to_markdown": "true",
        "label": "标题",
        "info": "栏目标题"
      },
      {
        "id": "description",
        "type": "textarea",
         "to_markdown": "true",
        "label": "描述",
        "info": "栏目描述"
      },
      {
        "id": "thumb_image_url",
        "type": "image_picker",
        "ratio": "16:9",
        "width": 400,
         "to_markdown": "true",
        "label": "封面图",
        "info": "栏目封面图片"
      }
    ]
  }
{% endschema %}
