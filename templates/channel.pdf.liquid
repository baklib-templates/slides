{% comment %} PDF 版本栏目页：按内容增高预览，Ctrl+P 多页打印给客户 {% endcomment %}
{% assign slides = page.children_in_list %}
{% assign slides_count = slides | size %}

<style>
  /* —— 打印：内容驱动高度，每张 slide 后强制分页 —— */
  @media print {
    @page {
      size: landscape;
      margin: 12mm;
    }

    html,
    body {
      width: auto !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      margin: 0 !important;
      padding: 0 !important;
      background: #fff !important;
      overflow: visible !important;
    }

    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
      box-shadow: none !important;
      text-shadow: none !important;
    }

    /* 解除主题/父级可能带来的裁剪，否则 Chrome 只渲第一页 */
    body *,
    .pdf-deck,
    .slide-page,
    .slide-content,
    .content-wrapper,
    .slide-closing,
    .slide-html-host {
      overflow: visible !important;
      max-height: none !important;
      height: auto !important;
    }

    .pdf-deck {
      display: block !important;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .slide-page {
      display: block !important;
      position: static !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 10mm 12mm !important;
      border: none !important;
      border-radius: 0 !important;
      background: #fff;
      page-break-after: always;
      break-after: page;
      page-break-inside: auto;
      break-inside: auto;
    }

    .slide-page:last-child {
      page-break-after: auto;
      break-after: auto;
    }

    .slide-content,
    .content-wrapper,
    .slide-closing,
    .slide-html-host {
      display: block !important;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      border-radius: 0 !important;
      flex: none !important;
      min-height: 0 !important;
    }

    .no-print {
      display: none !important;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img,
    svg,
    canvas,
    video {
      max-width: 100% !important;
      height: auto !important;
    }
  }

  /* —— 屏幕：居中限宽，高度随内容 —— */
  @media screen {
    html,
    body {
      margin: 0;
      padding: 0;
      background: #e8eef5;
    }

    .pdf-deck {
      display: block;
      width: 100%;
      max-width: 72rem; /* ~1152px，接近 max-w-6xl */
      margin: 0 auto;
      padding: 2rem 1.25rem 3rem;
    }

    .slide-page {
      display: block;
      width: 100%;
      height: auto;
      margin: 0 0 1.5rem;
      padding: 2.25rem 2.5rem;
      border: none;
      border-radius: 0.75rem;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
      background: #fff;
      overflow: visible;
    }

    .slide-content,
    .content-wrapper,
    .slide-closing,
    .slide-html-host {
      display: block;
      width: 100%;
      height: auto;
      max-width: none;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
    }

    .slide-closing {
      min-height: 22rem;
      padding: 3rem 1.5rem;
      border-radius: 0.75rem;
    }
  }

  /* —— 通用 —— */
  body {
    font-family: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #1e293b;
    line-height: 1.6;
  }

  .slide-closing {
    text-align: center;
    background: hsl(var(--theme-color-primary) / 0.12);
    color: inherit;
  }
</style>

<main class="pdf-deck">
  {% for slide in slides %}
    <section class="slide-page">
      <div class="slide-content">
        <div class="content-wrapper slide-html-host">
          {{ slide.settings.html_content }}
        </div>
      </div>
    </section>
  {% endfor %}

</main>

{% schema %}
  {
    "name": "栏目页 - PDF 版本",
    "description": "PDF 版本栏目页，按内容高度预览，适合 Ctrl+P 多页打印输出给客户",
    "thumb_url": "images/theme/thumb.png",
    "preview_image_urls": [
      "images/theme/${lang}/channel.png"
    ],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "title",
        "type": "text",
         "to_markdown": "true",
        "label": "标题",
        "info": "栏目标题"
      },
      {
        "id": "description",
        "type": "textarea",
         "to_markdown": "true",
        "label": "描述",
        "info": "栏目描述"
      },
      {
        "id": "thumb_image_url",
        "type": "image_picker",
        "ratio": "16:9",
        "width": 400,
         "to_markdown": "true",
        "label": "封面图",
        "info": "栏目封面图片"
      }
    ]
  }
{% endschema %}
